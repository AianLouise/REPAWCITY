# rePaw City web container: serves both React apps (client SPA + admin portal)
# via nginx and routes the Laravel API + storage to the `backend` service.
#
# Builds the frontend and copies both outputs + the nginx config into an
# nginx image. Route repawcity.com and admin.repawcity.com to this container.
FROM node:24-alpine AS frontend-build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=frontend-build /app/dist /usr/share/nginx/html
COPY --from=frontend-build /app/dist-admin /usr/share/nginx/admin
COPY deploy/nginx.docker.conf /etc/nginx/conf.d/default.conf
EXPOSE 80